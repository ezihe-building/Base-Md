# Telegram bot token from @BotFather (required for `npm start`)
BOT_TOKEN=

# Your numeric Telegram user ID (required; the bot owner)
OWNER_TELEGRAM_ID=

# Optional defaults
BOT_NAME=RICHY MD
DEV_NAME=Ezihe
PREFIX=.
# The bundled assets/menu.mp4 is used in both menus by default.
# MENU_IMAGES= can be set for a custom WhatsApp photo menu; separate URLs with |.
# CHANNEL_URL=
# GROUP_URL=

# Optional for the standalone WhatsApp process (`npm run dev`)
# PAIRING_NUMBER=
# CUSTOM_PAIRING_CODE=
